# MineTrace backend configuration (copy to .env and adjust).
# Every enterprise component has a zero-dependency fallback so the platform
# still runs fully offline on one laptop (SIH demo mode = all defaults).
# With infra/docker-compose.yml up, flip the four switches to run the exact
# abstract stack: PostgreSQL/PostGIS+pgvector, MinIO/S3, Keycloak, Temporal.

# --- App ---
MINETRACE_DEBUG=1
# MINETRACE_PORT=19823
# MINETRACE_DATA_DIR=C:\Users\<you>\AppData\Local\minetrace

# --- Database: sqlite (offline default) | postgres (PostgreSQL/PostGIS) ---
MINETRACE_DB_BACKEND=sqlite
# MINETRACE_PG_DSN=postgresql+psycopg://minetrace:minetrace@localhost:5432/minetrace

# --- Object storage: local (offline default) | s3 (MinIO, S3-compatible) ---
MINETRACE_STORAGE_BACKEND=local
# MINETRACE_MINIO_ENDPOINT=http://localhost:9000
# MINETRACE_MINIO_ACCESS_KEY=minetrace
# MINETRACE_MINIO_SECRET_KEY=minetrace123
# MINETRACE_MINIO_BUCKET=minetrace-documents

# --- Authentication: local argon2+JWT (offline default) | Keycloak SSO ---
MINETRACE_KEYCLOAK_ENABLED=false
# MINETRACE_KEYCLOAK_SERVER_URL=http://localhost:8180
# MINETRACE_KEYCLOAK_REALM=minetrace
# MINETRACE_KEYCLOAK_CLIENT_ID=minetrace-api

# --- Approval orchestration: in-process (offline default) | Temporal ---
MINETRACE_TEMPORAL_ENABLED=false
# MINETRACE_TEMPORAL_HOST=localhost:7233
# MINETRACE_TEMPORAL_NAMESPACE=default
# MINETRACE_TEMPORAL_TASK_QUEUE=minetrace-approvals

# --- LLM (Ollama, local) ---
# MINETRACE_OLLAMA_PRIMARY_MODEL=qwen3:8b
# MINETRACE_OLLAMA_FALLBACK_1=qwen2.5:7b
# MINETRACE_OLLAMA_SECONDARY_MODEL=llama3.1:8b

# --- Semantic retrieval ---
# Options: models/multilingual-e5-small (demo-safe, 384-dim)
#          models/bge-m3 (exact abstract stack, 1024-dim, ~2.3GB RAM)
# After switching models, re-ingest: python ../scripts/batch_ingest_dataset.py
# MINETRACE_EMBEDDING_MODEL_PATH=models/bge-m3
# MINETRACE_BGE_M3_DIM=1024
# MINETRACE_RERANKER_ENABLED=false
# MINETRACE_RERANKER_MODEL_PATH=models/bge-reranker-v2-m3

# --- Language / planning / analytics ---
# MINETRACE_HINDI_QUERY_TRANSLATION=true
# MINETRACE_WEATHER_ONLINE=false
# MINETRACE_WEATHER_PROVIDER=csv
# MINETRACE_PLAN_HORIZON_DAYS=7
# MINETRACE_ANOMALY_Z_THRESHOLD=3.0
# MINETRACE_FISCAL_YEAR_START_MONTH=4
